# Safe, isolated defaults for compose.test.yml. Test services publish no ports.
APP_ENV=test
LOG_LEVEL=WARNING
AI_EXTERNAL_CALLS_ENABLED=false

DB_USER=pecco_test
DB_PASSWORD=pecco_test
DB_NAME=pecco_test
DB_HOST=postgres
DB_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333

RABBITMQ_USER=pecco_test
RABBITMQ_PASSWORD=pecco_test
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Tests must not call external AI providers by default.
OPENAI_API_KEY=
OPENAI_MODEL=
