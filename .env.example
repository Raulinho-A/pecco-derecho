# Values in this file have two roles when used by the Makefile:
# 1. Compose uses --env-file for ${VARIABLE} interpolation.
# 2. The api service uses env_file to inject application variables.

# Application runtime
APP_ENV=development
LOG_LEVEL=DEBUG
AI_EXTERNAL_CALLS_ENABLED=false

# Compose host port
API_HOST_PORT=8000

# PostgreSQL runtime and Compose interpolation
DB_USER=pecco
DB_PASSWORD=pecco
DB_NAME=pecco
DB_HOST=postgres
DB_PORT=5432
POSTGRES_HOST_PORT=5432

# Qdrant runtime and Compose interpolation
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# RabbitMQ runtime and Compose interpolation
RABBITMQ_USER=pecco
RABBITMQ_PASSWORD=pecco
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Optional AI provider settings. Keep external calls disabled by default.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional debug-profile service
PGADMIN_EMAIL=admin@pecco.local
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5050
